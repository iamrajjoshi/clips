{
  "name": "clips.rajjoshi.me",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @clip/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "duplicates": "pnpm dlx jscpd --config .jscpd.json",
    "knip": "knip --include dependencies,devDependencies,unlisted,binaries",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm --filter @clip/web check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}

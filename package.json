{
  "name": "clips.rajjoshi.me",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @clip/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "duplicates": "pnpm dlx jscpd --config .jscpd.json",
    "knip": "knip --include dependencies,devDependencies,unlisted,binaries",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm --filter @clip/web check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.2.1",
    "globals": "^17.12.0",
    "knip": "^6.37.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
